{
  "name": "backend",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.4",
  "description": "BE_LMS - MERN + TS Backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "cross-env PORT=8005 ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "jest",
    "setup:toppings": "ts-node -r tsconfig-paths/register src/scripts/setup-product-toppings.ts",
    "backfill:recipes": "ts-node -r tsconfig-paths/register src/scripts/backfill-product-recipes.ts",
    "cleanup:unused-ingredients": "ts-node -r tsconfig-paths/register src/scripts/cleanup-unused-ingredients.ts",
    "rename:ingredients": "ts-node -r tsconfig-paths/register src/scripts/rename-ingredients.ts",
    "seed:staff": "ts-node -r tsconfig-paths/register src/scripts/seed-staff.ts",
    "sync:products": "ts-node -r tsconfig-paths/register src/scripts/sync-products-from-csv.ts"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@payos/node": "^2.0.5",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "cloudinary": "^1.41.3",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "mongoose": "^8.2.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.22",
    "@types/nodemailer": "^7.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
