{
  "name": "chain-restaurant-platform",
  "private": true,
  "scripts": {
    "dev:be": "cross-env PORT=8005 pnpm --filter backend dev",
    "dev:fe": "cross-env VITE_BASE_API=http://localhost:8005/api pnpm --filter fe-foa dev",
    "dev:all": "concurrently \"pnpm dev:be\" \"pnpm dev:fe\"",
    "build:be": "pnpm --filter backend build",
    "build:fe": "pnpm --filter fe-foa build",
    "build:all": "pnpm build:be && pnpm build:fe",
    "lint:be": "pnpm --filter backend lint",
    "lint:fe": "pnpm --filter fe-foa lint",
    "lint:all": "pnpm lint:be && pnpm lint:fe",
    "docker:up": "pnpm build:all && docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7"
  }
}
